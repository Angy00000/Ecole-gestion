{
  "rewrites": [
    {
      "source": "/d/:jeton",
      "destination": "/api/v2?__p=d/:jeton"
    },
    {
      "source": "/api/v2/:path*",
      "destination": "/api/v2?__p=:path*"
    },
    {
      "source": "/((?!api/|d/|assets/|logo|icon-|manifest|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v2/sauvegarde-auto",
      "schedule": "0 2 * * *"
    }
  ]
}