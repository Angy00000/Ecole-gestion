{
  "rewrites": [
    {
      "source": "/api/v2/:path*",
      "destination": "/api/v2?__p=:path*"
    },
    {
      "source": "/((?!api/|assets/|logo|icon-|manifest|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/parents",
      "destination": "https://easyschool-sn.vercel.app/parents?ecole=esjbm",
      "permanent": false
    },
    {
      "source": "/parents/:rest*",
      "destination": "https://easyschool-sn.vercel.app/parents?ecole=esjbm",
      "permanent": false
    },
    {
      "source": "/:path((?!api/|sw\\.js).*)",
      "destination": "https://easyschool-sn.vercel.app/?ecole=esjbm",
      "permanent": false
    }
  ]
}
